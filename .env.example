# Optional third-party traffic estimates. Similarweb requires a paid API key.
TRAFFIC_PROVIDER=similarweb
SIMILARWEB_API_KEY=
# Reserved for a future DataForSEO adapter; not used unless implemented.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Safe domain availability checks
OSINT_DOMAIN_CHECK_RETRIES=2
OSINT_SOURCE_CAPTURE_TIMEOUT_SECONDS=90
# Default priority-query budget for non-UI/API calls. The UI sends its selected depth.
OSINT_QUERY_BUDGET=12

# Self-hosted SearXNG search provider. Docker Compose supplies SEARXNG_URL to
# the application and workers. Replace this local secret before deployment.
SEARXNG_SECRET=replace-this-local-searxng-secret
OSINT_DISABLE_SEARXNG=false
# Direct providers remain fast; SearXNG needs enough time to finish its 4-second upstream window.
OSINT_SEARXNG_SEARCH_TIMEOUT=10

# VirusTotal v3 API. Keep the real key only in .env; never commit it.
VIRUSTOTAL_API_KEY=
EXTERNAL_CALLBACK_URL=http://10.244.0.148:8000/api/v1/ingestion/web-scraper/callback
EXTERNAL_DOMAIN_LIMIT=25

# Authenticated X/Twitter browser collection. The session JSON is generated locally;
# never put a username or password in this file.
X_STORAGE_STATE_PATH=/app/data/browser_sessions/x.json
X_MAX_SCROLLS=12
X_MAX_POSTS=100
X_SCROLL_WAIT_MS=900

# Authenticated social-browser collectors. Session JSON files are created by
# scripts/setup_<platform>_session.py; passwords are never stored here.
INSTAGRAM_STORAGE_STATE_PATH=/app/data/browser_sessions/instagram.json
FACEBOOK_STORAGE_STATE_PATH=/app/data/browser_sessions/facebook.json
TELEGRAM_STORAGE_STATE_PATH=/app/data/browser_sessions/telegram.json
YOUTUBE_STORAGE_STATE_PATH=/app/data/browser_sessions/youtube.json
QUORA_STORAGE_STATE_PATH=/app/data/browser_sessions/quora.json
INSTAGRAM_MAX_SCROLLS=8
FACEBOOK_MAX_SCROLLS=8
TELEGRAM_MAX_SCROLLS=8
YOUTUBE_MAX_SCROLLS=8
QUORA_MAX_SCROLLS=8
INSTAGRAM_MAX_ITEMS=60
FACEBOOK_MAX_ITEMS=60
TELEGRAM_MAX_ITEMS=60
YOUTUBE_MAX_ITEMS=60
QUORA_MAX_ITEMS=60
LOCAL_GID=1000

# Docker/PostgreSQL development settings. Replace the password before starting.
POSTGRES_DB=web_investigator
POSTGRES_USER=investigator
POSTGRES_PASSWORD=change-this-local-password

# Search and evidence collection (passed to both app and workers by Compose).
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CSE_ID=
OSINT_DISABLE_KEYLESS_SEARCH=false
OSINT_KEYLESS_SEARCH_TIMEOUT=5
OSINT_SEARCH_CACHE_TTL=86400
OSINT_SEARCH_REQUEST_DELAY=0.25
OSINT_SEARCH_LANGUAGE=en
OSINT_REQUEST_TIMEOUT=10
OSINT_RESULTS_PER_QUERY=10
OSINT_SOURCE_CRAWL_BUDGET=8
OSINT_EVIDENCE_SOURCE_BUDGET=8
OSINT_DOCUMENT_DOWNLOAD_BUDGET=100
OSINT_MAX_ARTIFACT_BYTES=5000000
OSINT_SOURCE_REQUEST_DELAY=0.5
OSINT_PAGE_TIMEOUT_MS=30000
OSINT_EVIDENCE_HEADLESS=true
PAGE_WORKERS=3
MAX_SCREENSHOTS_PER_SOURCE=5
OSINT_POPUP_CAPTURE_LIMIT=2

# Advisory text relevance review on the LAN; per-stage bounds.
OSINT_LLM_REVIEW_ENABLED=true
LM_STUDIO_BASE_URL=http://10.244.1.54:1234
LM_STUDIO_MODEL=google/gemma-4-e4b
LM_STUDIO_API_KEY=
OSINT_LLM_REVIEW_BUDGET=20
OSINT_LLM_TIMEOUT=15
OSINT_LLM_STAGE_SECONDS=60
OSINT_LLM_IMAGE_REVIEW_ENABLED=true
OSINT_LLM_IMAGE_REVIEW_BUDGET=0
OSINT_LLM_IMAGE_TIMEOUT=30
OSINT_LLM_IMAGE_STAGE_SECONDS=3600
## Individual social-post text capture (per platform, original snippets retained)
SOCIAL_POST_CAPTURE_LIMIT=15
OSINT_PUBLIC_SOCIAL_CAPTURE_BUDGET=25
SOCIAL_POST_CAPTURE_STAGE_SECONDS=60
SOCIAL_POST_CAPTURE_TIMEOUT_SECONDS=12
## Optional free dark-web collector. Start the Tor service with --profile darkweb.
## For a worker outside Docker, use socks5h://127.0.0.1:9050 instead.
DARKWEB_TOR_PROXY=socks5h://tor:9050
