# Optional third-party traffic estimates. Similarweb requires a paid API key.
TRAFFIC_PROVIDER=similarweb
SIMILARWEB_API_KEY=
# Reserved for a future DataForSEO adapter; not used unless implemented.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Safe domain availability checks
OSINT_DOMAIN_CHECK_RETRIES=2
OSINT_SOURCE_CAPTURE_TIMEOUT_SECONDS=60
# Default priority-query budget for non-UI/API calls. The UI sends its selected depth.
OSINT_QUERY_BUDGET=12

# Authenticated X/Twitter browser collection. The session JSON is generated locally;
# never put a username or password in this file.
X_STORAGE_STATE_PATH=/app/data/browser_sessions/x.json
X_MAX_SCROLLS=12
X_MAX_POSTS=100
X_SCROLL_WAIT_MS=900

# Authenticated social-browser collectors. Session JSON files are created by
# scripts/setup_<platform>_session.py; passwords are never stored here.
INSTAGRAM_STORAGE_STATE_PATH=/app/data/browser_sessions/instagram.json
FACEBOOK_STORAGE_STATE_PATH=/app/data/browser_sessions/facebook.json
TELEGRAM_STORAGE_STATE_PATH=/app/data/browser_sessions/telegram.json
YOUTUBE_STORAGE_STATE_PATH=/app/data/browser_sessions/youtube.json
QUORA_STORAGE_STATE_PATH=/app/data/browser_sessions/quora.json
INSTAGRAM_MAX_SCROLLS=8
FACEBOOK_MAX_SCROLLS=8
TELEGRAM_MAX_SCROLLS=8
YOUTUBE_MAX_SCROLLS=8
QUORA_MAX_SCROLLS=8
INSTAGRAM_MAX_ITEMS=60
FACEBOOK_MAX_ITEMS=60
TELEGRAM_MAX_ITEMS=60
YOUTUBE_MAX_ITEMS=60
QUORA_MAX_ITEMS=60
LOCAL_GID=1000

# Docker/PostgreSQL development settings. Replace the password before starting.
POSTGRES_DB=web_investigator
POSTGRES_USER=investigator
POSTGRES_PASSWORD=change-this-local-password
